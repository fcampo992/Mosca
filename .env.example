# Turso Database (obligatorio para producción)
# obtén estos valores desde https://cloud.turso.io
TURSO_DATABASE_URL=libsql://nombre-tu-base-datos.turso.io
TURSO_AUTH_TOKEN=tu_token_de_autenticacion

# Flask
SESSION_SECRET=un_secretosuperseguro_generado_con_openssl_o_python

# Admin (opcional, por defecto admin/admin)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=tu_contraseña_segura

# Cloudinary (opcional, para subir fotos de arqueros)
# CLOUDINARY_URL=cloudinary://... 
